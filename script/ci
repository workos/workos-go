#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT_DIR"

echo "==> go fmt ./..."
go fmt ./...

echo "==> go build ./..."
go build ./...

echo "==> go vet ./..."
go vet ./...

echo "==> go test ./..."
go test ./...

# The workload identity providers are separate Go modules, which ./... at the
# root does not enter.
for module in workloadidentity/githubactions workloadidentity/gcp workloadidentity/aws; do
  echo "==> go vet ./... ($module)"
  (cd "$module" && go vet ./...)

  echo "==> go test ./... ($module)"
  (cd "$module" && go test ./...)
done
